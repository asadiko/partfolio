{
  "extends": "astro/tsconfigs/strictest",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@fixtures/*": ["fixtures/*"]
    },
    "types": ["vitest/globals"]
  },
  "include": [".astro/types.d.ts", "src/**/*", "fixtures/**/*", "*.ts", "*.js"],
  "exclude": ["dist", "node_modules"]
}
