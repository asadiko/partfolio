---
import ThemeToggle from './ThemeToggle.astro';
import { nav, site } from '@/site';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`);
---

<header class="border-line bg-bg/85 sticky top-0 z-40 border-b backdrop-blur">
  <a
    href="#main"
    class="bg-accent text-accent-ink sr-only rounded-md px-3 py-2 focus:not-sr-only focus:absolute focus:top-2 focus:left-2"
    >Skip to content</a
  >
  <div class="mx-auto flex h-14 max-w-5xl items-center justify-between px-4 sm:px-6">
    <a href="/" class="text-ink font-semibold tracking-tight" title="Back to the desktop">
      <span class="text-accent mr-1.5" aria-hidden="true">◆</span>{site.shortName}
    </a>
    <nav aria-label="Primary" class="flex items-center gap-1 sm:gap-2">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'rounded-md px-2.5 py-1.5 text-sm transition-colors sm:px-3',
              isActive(item.href)
                ? 'bg-raised text-ink'
                : 'text-muted hover:bg-raised hover:text-ink',
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <ThemeToggle />
    </nav>
  </div>
</header>
