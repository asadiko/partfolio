---
import { withBase } from '@/site';
import { getCollection } from 'astro:content';

import PageHeader from '@/components/PageHeader.astro';
import Base from '@/layouts/Base.astro';

// Collection is wired; there are no posts yet and no nav link until there are.
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Base title="Writing">
  <PageHeader title="Writing" lede={posts.length === 0 ? 'Nothing published yet.' : undefined} />
  <ul class="m-0 list-none space-y-4 p-0">
    {
      posts.map((post) => (
        <li>
          <a
            href={withBase(`/blog/${post.id}`)}
            class="text-ink text-lg font-medium underline-offset-4 hover:underline"
          >
            {post.data.title}
          </a>
          <p class="text-muted m-0 text-sm">{post.data.summary}</p>
        </li>
      ))
    }
  </ul>
</Base>
