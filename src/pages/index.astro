---
import { getCollection } from 'astro:content';

import { Desk } from '@/islands/Desk';
import Base from '@/layouts/Base.astro';
import { loadDesktopData } from '@/lib/renderDocs';
import { site } from '@/site';
import '@/styles/os.css';

const data = await loadDesktopData();
const studies = (await getCollection('caseStudies')).sort((a, b) => a.data.order - b.data.order);
---

<Base bare>
  <Desk client:only="react" data={data} />
  <noscript>
    <section class="prose-site">
      <h1>{site.name}</h1>
      <p>{site.tagline}</p>
      <p>The interactive desktop needs JavaScript. The same content is available as plain pages:</p>
      <ul>
        {
          studies.map((s) => (
            <li>
              <a href={`/work/${s.id}`}>{s.data.title}</a>
            </li>
          ))
        }
        <li><a href="/journey">Journey</a></li>
        <li><a href="/about">About</a></li>
        <li><a href="/contact">Contact</a></li>
      </ul>
    </section>
  </noscript>
  <section class="sr-only" aria-label="Site summary">
    <h1>{site.name} — {site.tagline}</h1>
    <p>{site.description}</p>
    <ul>
      {
        studies.map((s) => (
          <li>
            <a href={`/work/${s.id}`}>{s.data.title}</a>: {s.data.summary}
          </li>
        ))
      }
    </ul>
  </section>
</Base>
